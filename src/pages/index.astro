---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ResearchAtlas from "../components/ResearchAtlas.astro";
import QuestionCard from "../components/QuestionCard.astro";
import SignalList from "../components/SignalList.astro";
import { getQuestions, getSignals } from "../lib/journal";
const questions = await getQuestions();
const recent = (await getSignals()).slice(0, 6);
const featured = questions.filter((q) => ["Q02", "Q06", "Q08"].includes(q.id));
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow hero-kicker">
        <span class="star" aria-hidden="true">
          ✳
        </span>{" "}
        TED QU <span class="slash">/</span> 个人研究手记
      </p>
      <h1 class="hero-title">
        Latent{" "}
        <em>
          Space<span>.</span>
        </em>
      </h1>
      <div class="hero-description">
        从模型的能力边界，到产品、商业与组织。
        <br class="wide-break" />
        记录 AI 改变真实工作的方式。
      </div>
      <div class="hero-actions">
        <a class="button-primary" href="/research/">
          探索研究问题 <Icon name="arrow" size={17} />
        </a>
        <a class="text-link hero-about" href="/about/">
          关于 Ted <Icon name="diagonal" size={14} />
        </a>
      </div>
    </div>
    <ResearchAtlas questions={questions} />
  </section>
  <section class="featured-section" aria-labelledby="featured-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">
          <i class="small-bar"></i> Research questions
        </p>
        <h2 id="featured-title">研究问题</h2>
      </div>
      <a class="all-link" href="/research/">
        查看全部 {questions.length} 个问题 <Icon name="arrow" size={16} />
      </a>
    </div>
    <div class="question-cards">
      {featured.map((q) => (
        <QuestionCard q={q} />
      ))}
    </div>
  </section>
  {recent.length > 0 && (
    <section class="reading-section" aria-labelledby="signals-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow"><i class="small-bar"></i> Latest insights</p>
          <h2 id="signals-title">近期洞察</h2>
        </div>
        <a class="all-link" href="/signals/">全部洞察 <Icon name="arrow" size={16} /></a>
      </div>
      <SignalList signals={recent} />
    </section>
  )}
</Layout>
