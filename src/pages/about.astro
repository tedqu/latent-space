---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import config from "../../site.config.json";
---

<Layout title="关于 Ted">
  <div class="about-page">
    <header class="page-heading">
      <p class="eyebrow">
        <i class="small-bar"></i>About
      </p>
      <h1 class="english-title">
        Ted{" "}
        <em>
          Qu<span class="period">.</span>
        </em>
      </h1>
      <p>关注 AI 应用、产品决策与组织协作。</p>
    </header>
    <div class="about-grid">
      <section>
        <h2>关于这本手记</h2>
        <p>
          Latent Space
          围绕长期问题追踪 AI 的变化。从模型如何行动，到产品怎样创造价值、团队如何分配责任，把论文、工程实践与市场材料放进同一张研究地图。
        </p>
        <p>每篇洞察保留原文、阅读批注与适用边界。新的证据持续回到相关问题中，逐步积累对技术、产品与商业的理解。</p>
        <a href="/research/" class="text-link">
          浏览研究问题 <Icon name="arrow" size={16} />
        </a>
      </section>
      <section>
        <h2>相关入口</h2>
        <a class="about-row" href={config.author.githubUrl}>
          <span>GitHub</span>
          <strong>
            @tedqu <Icon name="diagonal" size={15} />
          </strong>
        </a>
        <a class="about-row" href="https://www.polyu.edu.hk/research/">
          <span>{config.author.education}</span>
          <strong>
            研究官网 <Icon name="diagonal" size={15} />
          </strong>
        </a>
        <a class="about-row" href={config.repository.url}>
          <span>本站仓库</span>
          <strong>
            latent-space <Icon name="diagonal" size={15} />
          </strong>
        </a>
      </section>
    </div>
  </div>
</Layout>
