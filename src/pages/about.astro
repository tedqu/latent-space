---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import config from "../../site.config.json";
---

<Layout title="关于 Ted">
  <div class="about-page">
    <header class="page-heading">
      <p class="eyebrow">
        <i class="small-bar"></i>About
      </p>
      <h1 class="english-title">
        Ted{" "}
        <em>
          Qu<span class="period">.</span>
        </em>
      </h1>
      <p>香港理工大学校友，关注 AI 应用、产品决策与组织协作。</p>
    </header>
    <div class="about-grid">
      <section>
        <h2>关于这本手记</h2>
        <p>
          Latent Space
          围绕长期问题整理研究线索。从模型如何行动，到团队如何分配责任，这些问题横跨技术、产品、业务、商业和组织。
        </p>
        <a href="/research/" class="text-link">
          浏览研究问题 <Icon name="arrow" size={16} />
        </a>
      </section>
      <section>
        <h2>相关入口</h2>
        <a class="about-row" href={config.author.githubUrl}>
          <span>GitHub</span>
          <strong>
            @tedqu <Icon name="diagonal" size={15} />
          </strong>
        </a>
        <a class="about-row" href="/research/research-to-practice/">
          <span>PolyU</span>
          <strong>
            学术研究与应用 <Icon name="arrow" size={15} />
          </strong>
        </a>
        <a class="about-row" href={config.repository.url}>
          <span>本站仓库</span>
          <strong>
            latent-space <Icon name="diagonal" size={15} />
          </strong>
        </a>
      </section>
    </div>
  </div>
</Layout>
