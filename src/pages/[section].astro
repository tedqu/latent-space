---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import SignalList from "../components/SignalList.astro";
import { getQuestions, getSignals, sections } from "../lib/journal";
export function getStaticPaths() {
  return Object.entries(sections).map(([section, item]) => ({
    params: { section },
    props: { item },
  }));
}
const { item } = Astro.props;
const signals = Astro.params.section === "signals" ? await getSignals() : [];
const questionIds = signals.length ? signals.map((s) => s.data.question.id) : item.related;
const related = (await getQuestions()).filter((q) => questionIds.includes(q.id));
---

<Layout title={item.title}>
  <header class="page-heading">
    <p class="eyebrow">
      <i class="small-bar"></i>
      {item.english}
    </p>
    <h1>
      {item.title}
      <span class="period">.</span>
    </h1>
    <p>{item.intro}</p>
  </header>
  {signals.length > 0 ? (
    <section aria-label="资料观察">
      <p class="count">已收录 {signals.length} {item.unit}</p>
      <SignalList signals={signals} />
    </section>
  ) : <div class="archive-panel">
    <div class="archive-symbol" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <h2>{item.empty}</h2>
    <p>已收录 0 {item.unit}</p>
  </div>}
  <section class="related-section">
    <h2>相关研究问题</h2>
    <div class="question-list">
      {related.map((q) => (
        <a href={q.url}>
          <span class="question-id">{q.id}</span>
          <div class="row-title">
            <h3>{q.title}</h3>
          </div>
          <Icon name="diagonal" size={17} />
        </a>
      ))}
    </div>
  </section>
</Layout>
