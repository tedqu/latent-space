---
interface Props {
  type: string;
}
const { type } = Astro.props;
const orbit = Array.from({ length: 14 }, (_, i) => (i * 180) / 14);
const waves = Array.from({ length: 19 }, (_, row) =>
  Array.from({ length: 96 }, (_, i) => {
    const t = i / 95;
    const x = 12 + t * 150;
    const y =
      39 +
      (row - 9) * 2.5 +
      Math.sin(t * 6.2 + (row - 9) * 0.1) * 15 * Math.sin(Math.PI * t);
    return (i ? "L" : "M") + x.toFixed(1) + "," + y.toFixed(1);
  }).join(""),
);
---

<svg
  width="130"
  height="64"
  viewBox="0 0 180 82"
  fill="none"
  class="question-art"
  aria-hidden="true"
>
  {type === "Q02" ? (
    <g transform="translate(92 41) rotate(-15)">
      {orbit.map((deg) => (
        <ellipse
          rx="47"
          ry="14"
          transform={"rotate(" + deg + ")"}
          stroke="currentColor"
          stroke-width=".8"
        />
      ))}
      <ellipse
        rx="62"
        ry="13"
        transform="rotate(-12)"
        stroke="var(--accent)"
        stroke-width="1"
      />
      <circle cx="58" cy="-14" r="2.8" fill="var(--accent)" />
    </g>
  ) : type === "Q06" ? (
    <g>
      {waves.map((d, i) => (
        <path
          d={d}
          stroke={i === 13 ? "var(--accent)" : "currentColor"}
          stroke-width={i === 13 ? "1.7" : ".85"}
        />
      ))}
    </g>
  ) : (
    <g transform="translate(90 41)">
      {Array.from({ length: 11 }, (_, i) => (
        <path
          d={"M-48," + (-10 + i * 2.3) + "l47,-17 47,17 -47,17Z"}
          fill="var(--card)"
          stroke={i === 6 ? "var(--accent)" : "currentColor"}
          stroke-width=".9"
        />
      ))}
      <path d="M-1-31v12m-5-6h10" stroke="var(--accent)" stroke-width="1.4" />
    </g>
  )}
</svg>
