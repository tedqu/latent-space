---
import type { Question } from "../lib/journal";
interface Props {
  questions: Question[];
}
const { questions } = Astro.props;
type Point = [number, number];
const gaussian = (
  u: number,
  v: number,
  x: number,
  y: number,
  width: number,
  depth: number,
) => Math.exp(-(((u - x) / width) ** 2 + ((v - y) / depth) ** 2));
function project(u: number, v: number, flat = false): Point {
  const edge = Math.min(1, (1.02 - Math.abs(u)) * 5, (1.02 - Math.abs(v)) * 5);
  const ridge =
    1.19 * gaussian(u, v, -0.27, -0.31, 0.4, 0.53) +
    0.77 * gaussian(u, v, 0.53, -0.26, 0.33, 0.38) +
    0.74 * gaussian(u, v, -0.37, 0.47, 0.42, 0.31) +
    0.38 * gaussian(u, v, 0.35, 0.46, 0.47, 0.29);
  const detail =
    (0.052 * Math.sin(14 * u + 6 * v) +
      0.027 * Math.sin(17 * v - 9 * u) +
      0.016 * Math.cos(26 * u + 19 * v)) *
    Math.min(1, ridge);
  const z = flat ? 0 : (ridge + detail) * Math.max(0, edge);
  return [302 + (u - v) * 133, 222 + (u + v) * 51 - z * 135];
}
const xy = (p: Point) => p.map((n) => n.toFixed(1)).join(",");
const line = (pts: Point[]) => "M" + pts.map(xy).join("L");
const depth = 65,
  width = 94;
const seam = (v: number) =>
  Array.from({ length: width + 1 }, (_, i) => project((2 * i) / width - 1, v));
const strips = Array.from({ length: depth }, (_, i) => {
  const v0 = (2 * i) / depth - 1,
    v1 = (2 * (i + 1)) / depth - 1;
  const back = seam(v0),
    front = seam(v1);
  const cross = front
    .filter((_, j) => j % 2 === 0)
    .map((p, j) => line([back[2 * j], p]))
    .join("");
  return {
    patch: line([...back, ...front.slice().reverse()]) + "Z",
    edge: line(front),
    cross,
  };
});
const base = [
  project(-1, -1, true),
  project(1, -1, true),
  project(1, 1, true),
  project(-1, 1, true),
];
const anchors = [
  { id: "Q02", u: -0.27, v: -0.31, dx: 69, dy: 4 },
  { id: "Q06", u: 0.55, v: -0.25, dx: 28, dy: -27 },
  { id: "Q08", u: -0.38, v: 0.45, dx: -33, dy: -21 },
].map((a) => ({
  ...a,
  point: project(a.u, a.v),
  q: questions.find((q) => q.id === a.id)!,
}));
---

<figure class="atlas">
  <div class="atlas-paper">
    <div class="atlas-caption">
      <span class="mini-cross" aria-hidden="true"></span> Research Atlas
    </div>
    <svg
      class="atlas-art"
      viewBox="0 0 604 354"
      role="group"
      aria-label="研究地形图，选择地标访问对应研究问题"
    >
      <defs>
        <pattern
          id="survey-grid"
          width="22"
          height="22"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M22 0H0V22"
            fill="none"
            stroke="var(--map-grid)"
            stroke-width=".6"
          />
        </pattern>
      </defs>
      <rect width="604" height="354" fill="url(#survey-grid)" />
      <g
        fill="none"
        stroke="var(--map-axis)"
        stroke-width=".8"
        stroke-dasharray="3 5"
      >
        <path d={line([project(-1.13, -1, true), project(1.13, -1, true)])} />
        <path d={line([project(-1, -1.13, true), project(-1, 1.13, true)])} />
      </g>
      <path
        d={line([...base, base[0]])}
        fill="var(--map-ground)"
        stroke="var(--map-line)"
        stroke-width=".7"
      />
      <path
        d={
          line([
            base[1],
            base[2],
            base[3],
            [base[3][0], base[3][1] + 5],
            [base[2][0], base[2][1] + 5],
            [base[1][0], base[1][1] + 5],
          ]) + "Z"
        }
        fill="var(--map-side)"
        stroke="var(--map-line)"
        stroke-width=".75"
      />
      {strips.map((s) => (
        <g>
          <path d={s.patch} fill="var(--map-ground)" />
          <path
            d={s.cross}
            fill="none"
            stroke="var(--map-line)"
            stroke-width=".49"
            opacity=".78"
          />
          <path
            d={s.edge}
            fill="none"
            stroke="var(--map-line)"
            stroke-width=".92"
          />
        </g>
      ))}
      {anchors.map((a) => {
        const [x, y] = a.point,
          labelX = x + a.dx,
          labelY = y + a.dy;
        return (
          <a href={a.q.url} aria-label={a.q.title} class="map-pin">
            <title>{a.q.title}</title>
            <path
              d={
                "M" +
                x +
                "," +
                y +
                "V" +
                (labelY + 8) +
                "L" +
                labelX +
                "," +
                (labelY + 8)
              }
              stroke="var(--map-accent)"
              fill="none"
              stroke-width="1"
            />
            <circle
              cx={x}
              cy={y}
              r="4.2"
              fill="var(--map-accent)"
              stroke="var(--map-ground)"
              stroke-width="1.4"
            />
            <g transform={"translate(" + labelX + " " + labelY + ")"}>
              <g class="map-tag">
                <rect
                  class="pin-hit"
                  x="-42"
                  y="-26"
                  width="84"
                  height="48"
                  fill="transparent"
                />
                <rect
                  class="pin-label-bg"
                  x="-35"
                  y="-14"
                  width="70"
                  height="24"
                  rx="2"
                />
                <text x="0" y="2" text-anchor="middle">
                  {a.q.topic}
                </text>
              </g>
            </g>
          </a>
        );
      })}
    </svg>
    <span class="plate-corner corner-tl" aria-hidden="true"></span>
    <span class="plate-corner corner-tr" aria-hidden="true"></span>
    <span class="plate-corner corner-bl" aria-hidden="true"></span>
    <span class="plate-corner corner-br" aria-hidden="true"></span>
  </div>
  <figcaption>
    <span>研究地形图</span>
    <span class="atlas-hint">
      <i></i> 选择地标以探索问题
    </span>
  </figcaption>
</figure>
